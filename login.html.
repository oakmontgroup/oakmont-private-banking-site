
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#001a14">
  <title>Sign In | Oakmont Private Banking</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <span class="muted">Secure Account Access</span>
      <nav class="nav-links">
        <a href="index.html">Home</a>
        <a href="register.html">Create Account</a>
      </nav>
    </div>
  </header>

  <div class="container brandbar">
    <a class="brand" href="index.html">
      <span class="brand-mark" aria-hidden="true">O</span>
      <span>
        <span class="brand-name">OAKMONT</span>
        <span class="brand-subtitle" style="display:block">PRIVATE BANKING</span>
      </span>
    </a>
  </div>

  <main class="form-wrap">
    <section class="panel">
      <p class="eyebrow">Welcome back</p>
      <h1 style="font-size:2.2rem">Sign in to your account</h1>
      <p>Enter your registered email address and password.</p>

      <div id="login-message" class="notice hidden" role="status"
           aria-live="polite"></div>

      <form id="login-form">
        <div class="form-group">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email"
                 autocomplete="username" required
                 placeholder="you@example.com">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password"
                 autocomplete="current-password" required
                 placeholder="Enter your password">
        </div>

        <button id="login-button" type="submit">Sign In</button>
      </form>

      <p class="form-footer">
        Don't have an account?
        <a href="register.html">Create an account</a>
      </p>
      <p class="form-footer">
        <a href="index.html">Return to homepage</a>
      </p>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <p>© <span id="year"></span> Oakmont Private Banking</p>
    </div>
  </footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();

    document.getElementById("login-form").addEventListener("submit", function(event) {
      event.preventDefault();

      const message = document.getElementById("login-message");
      message.classList.remove("hidden");
      message.classList.remove("error", "success");
      message.classList.add("notice");
      message.textContent =
        "Account authentication is not connected yet. Please try again after setup.";
    });
  </script>
</body>
</html>
